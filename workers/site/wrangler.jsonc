{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lowbook",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Built by `npm run build` at the repo root.
    "directory": "../../apps/charts/dist",
    // Client-side routes (/chart/:id, /print) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker code; everything else is served as a static asset.
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
}
